VERSION_PATTERN = re.compile(r"^(?:harness-)?(\d{4}\.\d{2}\.\d+)$")
PUBLIC_ROOT_FILES = {"AGENTS.md", "CLAUDE.md", "work-wsl.sh", "README.md", "LICENSE", ".gitignore", "release", "release.ps1",
                     "work", "work.cmd", "work.ps1", "windows-runtime.lock.json",
                     "windows-npm.lock.json", "skills-lock.json", "workspace.ps1", "THIRD_PARTY_NOTICES.md"}

# Shipped artifacts that must never enter a product package (D13/D14/D16).
FORBIDDEN_ASSET_DIRS = (".studio/components", ".studio/backgrounds", ".studio/designs/shared")
FORBIDDEN_TEXT_SUFFIXES = {".md", ".json", ".yaml", ".yml", ".py", ".js", ".mjs", ".cjs", ".ts", ".css",
                           ".html", ".txt", ".toml", ".cfg", ".ini", ".sh", ".cmd", ".ps1", ".template"}
# Keep fingerprints, not production titles, in public source.
FORBIDDEN_TITLE_HASHES = ((6, 'ea59336b8bcf84149a40bbd6640469d08f5eec909c325c372931e1df6637e341'), (6, 'c64ef31bca565b9712aeb32637f091e8890ceae6b19591bd50b44ee6663d345c'), (15, 'aa90c8b9fa526ae450ce516127d78d938b521c164562b2bff8016263ad98aaae'), (15, '33caca4a64ff26f6d568d5f63652289531ebe1918e667c8f6980b585acd3c3e4'))
PRIVATE_PATH = re.compile(r"/(?:home/[A-Za-z0-9_.-]+/|mnt/[a-z]/)|[A-Za-z]:[\\/]+AI[\\/]", re.I)
PRIVATE_OVERLAY = ("personal/", ".agents/skills/tts/", ".agents/skills/hermes-media-download/")
# Root files the private source may supply in place of the public ones: rules and the local WSL entry wiring.
PRODUCT_VERSION = "4.2.0"
# Private root files replace these public counterparts; `bases` pins the public bytes each one was reviewed against.
PRIVATE_RULE_BASES = {"AGENTS.md": ".studio/templates/WINDOWS_AGENTS.md", "CLAUDE.md": ".studio/templates/CLAUDE.template.md",
                      "work-wsl.sh": "work-wsl.sh"}
PRIVATE_RULE_FILES = set(PRIVATE_RULE_BASES)
CARD_ID = re.compile(r"[a-z][a-z0-9-]*")
# Research notes stay in the card repository; deployments ship only the card itself.
CARD_EXCLUDED_DIRS = {"study"}


def private_overlay(name: str) -> bool:
    return name.startswith(PRIVATE_OVERLAY)


class ReleaseError(RuntimeError):
    pass


def run(*args: str, cwd: Path = REPO, capture: bool = False) -> str:
    result = subprocess.run(
        args, cwd=cwd, check=True, text=True, stdout=subprocess.PIPE if capture else None
    )
    return result.stdout.strip() if capture else ""


def version_tag(value: str) -> tuple[str, str]:
    match = VERSION_PATTERN.fullmatch(value)
    if not match:
        raise ReleaseError("Version must look like 2026.09.1 or harness-2026.09.1")
    version = match.group(1)
    return version, f"harness-{version}"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def directory_sha256(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file() and "__pycache__" not in p.parts):
        if path.suffix in {".pyc", ".pyo"}:
            continue
        relative = path.relative_to(root).as_posix().encode()
        digest.update(len(relative).to_bytes(4, "big"))
        digest.update(relative)
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def check_env() -> dict:
    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    parser = REPO / ".studio/.runtime/dependency-parser"
    if not all((parser / "node_modules" / name).is_dir() for name in ("acorn", "esbuild")):
        raise ReleaseError("Install the pinned WSL dependency parser with prepare_windows_runtime.py dev-parser before building")
    env["HYPERFRAMES_DEPENDENCY_MODULE_ROOT"] = str(parser)
    # Frozen source packages have no node_modules; reuse installed WSL test dependencies.
    env["NODE_PATH"] = os.pathsep.join([str(REPO / ".studio/parser/node_modules"),
                                      str(REPO / "node_modules"), env.get("NODE_PATH", "")])
    return env


def release_checks(root: Path, *, packaged: bool = False) -> None:
    env = check_env()
    subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p",
         "test_asset_entry.py" if packaged else "test_*.py", "-q"],
        cwd=root,
        env=env,
        check=True,
    )
    if packaged:
        return
    subprocess.run(
        [sys.executable, ".agents/skills/hyperframes-production-workflow/scripts/validate_package.py"],
        cwd=root,
        env=env,
        check=True,
    )


def safe_member(name: str) -> Path:
    if "\\" in name or ":" in name or not name or name.startswith("/") or ".." in name.split("/"):
        raise ReleaseError(f"Unsafe archive path: {name}")
    return Path(name)


def extract_zip(source: Path, destination: Path, strip_prefix: str = "") -> None:
    with zipfile.ZipFile(source) as bundle:
        for entry in bundle.infolist():
            safe_member(entry.filename)
            if (entry.external_attr >> 16) & 0o170000 == 0o120000:
                raise ReleaseError("Runtime archive must not contain symlinks")
            name = entry.filename
            if strip_prefix:
                if name.rstrip("/") == strip_prefix.rstrip("/"):
                    continue
                if not name.startswith(strip_prefix.rstrip("/") + "/"):
                    raise ReleaseError(f"Runtime member outside strip_prefix: {name}")
                name = name[len(strip_prefix.rstrip("/")) + 1:]
            target = destination / safe_member(name)
            if entry.is_dir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with bundle.open(entry) as stream, target.open("xb") as output:
                    shutil.copyfileobj(stream, output)


def stage_runtime(staging: Path, cache: Path) -> dict[str, str]:
    lock = json.loads((staging / "windows-runtime.lock.json").read_text(encoding="utf-8"))
    assets = lock.get("assets")
    if lock.get("target") != "windows-x64" or not isinstance(assets, list) or not assets:
        raise ReleaseError("Invalid Windows runtime lock")
    if lock.get("pending_assets"):
        raise ReleaseError("Windows runtime closure incomplete: " + ", ".join(lock["pending_assets"]))
    if not lock.get("required_files"):
        raise ReleaseError("Runtime lock must declare the complete native execution chain")
    runtime = staging / "runtime" / "python"
    site_packages = runtime / "Lib" / "site-packages"
    runtime.mkdir(parents=True)
    site_packages.mkdir(parents=True)
    hashes: dict[str, str] = {}
    for asset in assets:
        if len(safe_member(asset["file"]).parts) != 1:
            raise ReleaseError("Runtime asset file must be a cache basename")
        source = cache / asset["file"]
        if not source.is_file() or sha256(source) != asset["sha256"]:
            raise ReleaseError(f"Missing or invalid locked runtime asset: {source}")
        hashes[asset["file"]] = asset["sha256"]
        kind = asset["kind"]
        if kind in {"python", "wheel"}:
            destination = runtime if kind == "python" else site_packages
        elif kind in {"zip", "npm-tree"}:
            relative = safe_member(asset["target"])
            if relative.parts[0] != "runtime":
                raise ReleaseError("Runtime target must be under runtime/")
            destination = staging / relative
        else:
            raise ReleaseError(f"Unknown runtime asset kind: {kind}")
        extract_zip(source, destination, asset.get("strip_prefix", ""))
        if sha256(source) != asset["sha256"]:
            raise ReleaseError(f"Runtime changed while staging: {source.name}")
    pth_files = list(runtime.glob("python*._pth"))
    if len(pth_files) != 1:
        raise ReleaseError("Embedded Python ._pth file is missing")
    lines = [line for line in pth_files[0].read_text(encoding="utf-8").splitlines() if line != "#import site"]
    lines.extend(["Lib/site-packages", "import site"])
    pth_files[0].write_text("\n".join(lines) + "\n", encoding="utf-8", newline="\n")
    for name in lock["required_files"]:
        relative = safe_member(name)
        if relative.parts[0] != "runtime" or not (staging / relative).is_file():
            raise ReleaseError(f"Native runtime closure is missing: {name}")
    return hashes


def write_zip(source: Path, archive: Path, prefix: str, timestamp: int, *, verified_runtime: dict | None = None) -> None:
    assert_no_development_harness(source)
    assert_no_forbidden_artifacts(source, verified_runtime=verified_runtime)
    dt = datetime.fromtimestamp(timestamp, timezone.utc)
    zip_time = (max(dt.year, 1980), dt.month, dt.day, dt.hour, dt.minute, dt.second)
    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as bundle:
        for path in sorted(p for p in source.rglob("*") if p.is_file()):
            info = zipfile.ZipInfo(f"{prefix}/{path.relative_to(source).as_posix()}", zip_time)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = (0o755 if os.access(path, os.X_OK) else 0o644) << 16
            bundle.writestr(info, path.read_bytes(), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)


def strip_bundled_assets(staging: Path) -> None:
    """Keep migration fixtures in the checkout, not the Windows application."""
    for name in ("components", "backgrounds"):
        directory = staging / ".studio" / name
        if directory.is_dir():
            shutil.rmtree(directory)


def strip_development_outputs(staging: Path) -> None:
    if (staging / 'tests').exists():
        shutil.rmtree(staging / 'tests')
    for directory in list(staging.rglob('__pycache__')):
        if directory.is_dir():
            shutil.rmtree(directory)


def verified_archive(archive: Path) -> str:
    checksum = archive.with_suffix(archive.suffix + ".sha256")
    if not archive.is_file() or not checksum.is_file():
        raise ReleaseError("Archive and matching .sha256 file are required")
    fields = checksum.read_text(encoding="ascii").strip().split()
    if len(fields) != 2 or fields[1] != archive.name or fields[0] != sha256(archive):
        raise ReleaseError(f"Checksum verification failed: {archive}")
    with zipfile.ZipFile(archive) as bundle:
        roots = {Path(name).parts[0] for name in bundle.namelist() if name}
        for name in bundle.namelist():
            safe_member(name)
    if len(roots) != 1:
        raise ReleaseError("Release ZIP must contain one safe top-level directory")
    return roots.pop()


def development_harness(name: str) -> bool:
    parts = safe_member(name).as_posix().casefold().split("/")
    return parts[0] in {".trellis", ".codex", ".claude", "agents.override.md", "board.md"} or (
        len(parts) >= 3 and parts[:2] == [".agents", "skills"]
        and (parts[2].startswith("trellis-") or parts[2] == "gitnexus")
    )


def assert_no_development_harness(staging: Path) -> None:
    for path in staging.rglob("*"):
        name = path.relative_to(staging).as_posix()
        if development_harness(name):
            raise ReleaseError(f"Development Harness must not enter a product package: {name}")


def gsap_library_file(name: str) -> bool:
    """GSAP and its plugins ship through the locked host npm tree, never in source (D14)."""
    lowered = name.casefold()
    return lowered.endswith(".js") and (lowered.startswith("gsap") or lowered.startswith("customease")
                                        or lowered.endswith("plugin.min.js"))


def forbidden_artifact(staging: Path, *, verified_runtime: dict | None = None) -> str | None:
    private_cards = tuple(f".studio/designs/{card}/" for card in personal_card_ids(staging))
    for path in sorted(staging.rglob("*")):
        relative = path.relative_to(staging).as_posix()
        if relative.startswith("runtime/npm/node_modules/gsap/"):
            continue  # the locked runtime hosts GSAP and other third-party libraries
        if path.is_dir():
            if relative in FORBIDDEN_ASSET_DIRS:
                return relative
            continue
        # Verified upstream bytes may contain example paths and legitimate gsapParser modules.
        if (relative.startswith("runtime/") and verified_runtime is not None
                and verified_runtime.get(relative) == sha256(path)):
            continue
        if gsap_library_file(path.name) or path.name == "stage-provenance.json":
            return relative
        if relative.startswith("docs/PRD/"):
            continue  # historical PRDs are explicitly preserved unchanged
        if relative.startswith(private_cards):
            continue  # locked private cards are personal content already present in the user's own root
        if path.suffix.casefold() not in FORBIDDEN_TEXT_SUFFIXES:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        # The private overlay is machine wiring by definition; public_source() keeps it out of public packages.
        if not private_overlay(relative) and PRIVATE_PATH.search(text):
            return relative + " contains a machine path"
        for length, expected in FORBIDDEN_TITLE_HASHES:
            if any(hashlib.sha256(text[offset:offset + length].encode()).hexdigest() == expected
                   for offset in range(len(text) - length + 1)):
                return relative + " contains a production title"
    return None


def assert_no_forbidden_artifacts(staging: Path, *, verified_runtime: dict | None = None) -> None:
    found = forbidden_artifact(staging, verified_runtime=verified_runtime)
    if found:
        raise ReleaseError(f"Forbidden product artifact: {found}")


def package_scopes() -> dict:
    # The standalone Windows installer has no source tree and does not build packages.
    return json.loads((REPO / '.studio/package-scopes.json').read_text(encoding='utf-8'))


def personal_card_source(name: str) -> bool:
    return (name.startswith(tuple(package_scopes()['personal_prefixes']))
            or name in package_scopes()['personal_files'])


def public_source(name: str) -> bool:
    path = safe_member(name)
    if development_harness(name) or personal_card_source(name):
        return False
    if private_overlay(name) or name in {
            'asr-wsl.cmd', '.studio/asr_wsl_bridge.py', 'tests/test_asr_wsl_bridge.py'}:
        return False
    forbidden = {".git", ".runtime", "__pycache__", "node_modules", "works", "sample-library", "known-defects", "retro-summary", "content-summary", "requests", "review",
                 "credentials", "secrets", ".env", ".codex", "dist"}
    if any(part in forbidden or part.startswith(".env.") for part in path.parts):
        return False
    if path.suffix.lower() in {".pem", ".key", ".p12", ".pyc", ".pyo"}:
        return False
    return name in PUBLIC_ROOT_FILES or name.startswith((".studio/", ".agents/skills/", "docs/", "tests/"))


def source_hashes(includes: list[str], repo: Path = REPO) -> dict[str, str]:
    declaration = repo / '.studio/release-sources.json'
    if not declaration.is_file() or declaration.is_symlink():
        raise ReleaseError('Missing explicit public source manifest: .studio/release-sources.json')
    manifest = json.loads(declaration.read_text(encoding='utf-8'))
    files = manifest.get('files') if isinstance(manifest, dict) else None
    if (not isinstance(files, list) or not files or any(not isinstance(name, str) for name in files)
            or len(set(files)) != len(files) or manifest.get('version') != 1):
        raise ReleaseError('Invalid public source manifest')
    names = set(files)
    for name in names:
        if not public_source(name):
            raise ReleaseError('Public manifest contains forbidden source: ' + name)
    for name in includes:
        if not public_source(name) or not (repo / name).is_file():
            raise ReleaseError(f"Explicit candidate source is not a public product file: {name}")
        names.add(name)
    hashes = {}
    for name in sorted(names):
        source = repo / name
        if (any(parent.is_symlink() for parent in [source, *source.parents]) or not source.is_file()
                or source.stat().st_nlink != 1):
            raise ReleaseError(f"Candidate source must be a regular local file: {name}")
        hashes[name] = sha256(source)
    return hashes


def freeze_sources(staging: Path, includes: list[str], repo: Path = REPO) -> dict[str, str]:
    hashes = source_hashes(includes, repo)
    for name in hashes:
        target = staging / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(repo / name, target)
    # Detect edits during the copy instead of assigning mixed bytes a Git identity.
    for name, digest in hashes.items():
        if sha256(repo / name) != digest or sha256(staging / name) != digest:
            raise ReleaseError(f"Source changed while freezing; retry: {name}")
    return hashes


def candidate_fingerprint(includes, channel, runtime_files, personal_source=None):
    value = {'sources': source_hashes(includes), 'skills': {}, 'channel': channel,
             'runtime_files': runtime_files, 'private': {}}
    data = personal_manifest(personal_source) if personal_source is not None else {}
    for name, expected in LOCAL_SKILLS.items():
        if name in data.get('exclude_skills', []):
            continue
        actual = directory_sha256(REPO / '.agents/skills' / name)
        if actual != expected:
            raise ReleaseError('Missing or changed local release dependency: ' + name)
        value['skills'][name] = actual
    if personal_source is not None:
        declaration = personal_source / 'release-sources.json'
        value['private']['manifest'] = sha256(declaration)
        for name, expected in data['files'].items():
            if personal_card_source(name):
                continue
            path = personal_source / safe_member(name)
            if not path.is_file() or any(p.is_symlink() for p in (path, *path.parents)) or sha256(path) != expected:
                raise ReleaseError('Private source missing, linked or changed: ' + name)
            value['private'][name] = expected
        if 'cards' in data:
            lock = card_lock(personal_source, data['cards'])
            value['private']['cards'] = {'commit': lock['commit'], 'ids': lock['ids']}
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def module_manifest(staging: Path) -> dict:
    groups = {}
    for path in sorted(staging.rglob('*')):
        if not path.is_file():
            continue
        name = path.relative_to(staging).as_posix()
        parts = name.split('/')
        if name.startswith('runtime/') or name == '.studio/release-sources.json':
            continue
        if name.startswith('.studio/designs/') and len(parts) > 3:
            module = 'design/' + parts[2]
        elif personal_card_source(name):
            module = 'assets/personal'
        elif name.startswith(('.studio/fonts/', '.studio/painter/', '.studio/components/')):
            module = 'assets/' + parts[1]
        elif name.startswith('.agents/skills/') and len(parts) > 3:
            module = 'skill/' + parts[2]
        elif name.startswith('personal/'):
            module = 'personal'
        else:
            module = 'core'
        groups.setdefault(module, {})[name] = sha256(path)
    result = {}
    for name, files in groups.items():
        digest = hashlib.sha256(json.dumps(files, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
        version = '4.2.0'
        if name.startswith('design/') and name != 'design/shared':
            card = staging / '.studio/designs' / name.split('/')[1] / 'design.json'
            if card.is_file():
                version = json.loads(card.read_text(encoding='utf-8'))['version']
        result[name] = {'version': version, 'sha256': digest, 'compatibility': {'product': '4.0.0'}, 'files': files}
    lock = staging / 'windows-runtime.lock.json'
    if lock.is_file():
        result['runtime'] = {'sha256': sha256(lock), 'version': 'locked', 'compatibility': {'target': 'windows-x64'}}
    return result


def skill_lock_bytes(path: Path, excluded) -> bytes:
    if not excluded:
        return path.read_bytes()
    lock = json.loads(path.read_text(encoding='utf-8'))
    lock['skills'] = {name: value for name, value in lock['skills'].items() if name not in excluded}
    return (json.dumps(lock, indent=2) + '\n').encode('utf-8')


def stage_skills(staging: Path, excluded=()) -> dict[str, str]:
    for name, locked_hash in LOCAL_SKILLS.items():
        if name in excluded:
            continue
        source = REPO / ".agents" / "skills" / name
        if not (source / "SKILL.md").is_file() or directory_sha256(source) != locked_hash:
            raise ReleaseError(f"Missing or changed local release dependency: {name}")
        target = staging / ".agents" / "skills" / name
        shutil.copytree(source, target, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "*.pyo"))
        if directory_sha256(target) != locked_hash:
            raise ReleaseError(f"Local dependency changed while freezing: {name}")
    if excluded:
        lock = staging / 'skills-lock.json'
        lock.write_bytes(skill_lock_bytes(lock, excluded))
    return {name: value for name, value in LOCAL_SKILLS.items() if name not in excluded}


def stage_windows_rules(staging: Path) -> None:
    template = staging / ".studio/templates/WINDOWS_AGENTS.md"
    if not template.is_file():
        raise ReleaseError("Windows root rules are missing from the frozen sources")
    shutil.copyfile(template, staging / "AGENTS.md")
    claude = staging / ".studio/templates/CLAUDE.template.md"
    if not claude.is_file():
        raise ReleaseError("Claude production rules are missing from the frozen sources")
    shutil.copyfile(claude, staging / "CLAUDE.md")
    module_rules = staging / '.studio/templates/STUDIO_AGENTS.md'
    if module_rules.is_file():
        shutil.copyfile(module_rules, staging / '.studio/AGENTS.md')
    master = staging / 'docs/PRD/PRD_MASTER.md'
    if master.is_file():
        master.write_text(''.join(line for line in master.read_text(encoding='utf-8').splitlines(keepends=True)
                                  if not line.startswith('开发设计记录（本地、不配送）：')), encoding='utf-8')
    elif (staging / '.studio/AGENTS.md').exists():
        raise ReleaseError('Missing public module rules; refusing to ship development rules')


def personal_manifest(source: Path) -> dict:
    manifest_path = source / 'release-sources.json'
    if not manifest_path.is_file():
        raise ReleaseError('Personal package requires private source release-sources.json')
    declaration = json.loads(manifest_path.read_text(encoding='utf-8'))
    if (not isinstance(declaration, dict) or not {'version', 'compatibility', 'files'} <= set(declaration)
            or set(declaration) - {'version', 'compatibility', 'files', 'exclude_skills', 'cards', 'bases'}
            or not isinstance(declaration['files'], dict) or not declaration['files']):
        raise ReleaseError('Invalid private source manifest')
    excluded = declaration.get('exclude_skills', [])
    if (not isinstance(excluded, list) or any(not isinstance(name, str) or name not in LOCAL_SKILLS for name in excluded)
            or len(excluded) != len(set(excluded))):
        raise ReleaseError('Invalid excluded skills: use unique locked local skill names')
    compatibility = declaration['compatibility']
    if not isinstance(compatibility, dict) or compatibility.get('product') != PRODUCT_VERSION:
        raise ReleaseError(f'Private source targets product {compatibility.get("product") if isinstance(compatibility, dict) else None}, '
                           f'this tool is {PRODUCT_VERSION}; review the private files and update compatibility.product')
    bases = declaration.get('bases', {})
    replaced = PRIVATE_RULE_FILES & set(declaration['files'])
    if not isinstance(bases, dict) or set(bases) != replaced:
        raise ReleaseError('Private bases must name exactly the replaced root files: ' + ', '.join(sorted(replaced)))
    for name in sorted(replaced):
        public = REPO / PRIVATE_RULE_BASES[name]
        if bases[name] != sha256(public):
            raise ReleaseError(f'Private {name} was reviewed against older public {PRIVATE_RULE_BASES[name]}; '
                               f'merge the public change into the private file, then set bases.{name} to {sha256(public)}')
    return declaration


def card_lock(source: Path, value) -> dict:
    """Validate the private card pin: an exact commit of the card repository and the card ids it ships."""
    if not isinstance(value, dict) or set(value) != {'source', 'commit', 'ids'}:
        raise ReleaseError('Invalid card lock: use source, commit and ids')
    ids = value['ids']
    if (not isinstance(ids, list) or not ids or len(ids) != len(set(ids))
            or any(not isinstance(card, str) or not CARD_ID.fullmatch(card) for card in ids)):
        raise ReleaseError('Invalid card lock ids: use unique lowercase card ids')
    public = set(package_scopes()['public_cards'])
    if public & set(ids):
        raise ReleaseError('Personal card id collides with a public card: ' + ', '.join(sorted(public & set(ids))))
    if not isinstance(value['commit'], str) or not re.fullmatch(r'[0-9a-f]{40}', value['commit']):
        raise ReleaseError('Card lock commit must be a full 40-character Git commit id')
    if not isinstance(value['source'], str) or not value['source']:
        raise ReleaseError('Card lock source must name the card repository')
    repo = (source / value['source']).resolve()
    if not repo.is_dir():
        raise ReleaseError(f'Card repository not found: {repo}')
    exists = subprocess.run(['git', '-C', str(repo), 'cat-file', '-e', value['commit'] + '^{commit}'], capture_output=True)
    if exists.returncode:
        raise ReleaseError(f'Card lock commit is missing from {repo}: {value["commit"]}')
    for card in ids:
        found = subprocess.run(['git', '-C', str(repo), 'cat-file', '-e', f'{value["commit"]}:{card}/design.json'], capture_output=True)
        if found.returncode:
            raise ReleaseError(f'Locked card commit has no {card}/design.json')
    return {'repo': repo, 'commit': value['commit'], 'ids': list(ids)}


def validate_cards(staging: Path) -> None:
    """Card content is checked by the card validator; the tool test suite never sees personal cards."""
    before = sorted(p.relative_to(staging).as_posix() for p in staging.rglob('*'))
    env = {**check_env(), 'HYPERFRAMES_AI_RESOLVED_CONFIG': '{}', 'HYPERFRAMES_AI_CONFIG': '', 'HYPERFRAMES_AI_ASSET_CONFIG': '',
           'HYPERFRAMES_AI_HOME': '', 'HYPERFRAMES_AI_REVIEW': '0', 'PYTHONDONTWRITEBYTECODE': '1'}
    result = subprocess.run([sys.executable, '-B', '.studio/work.py', '--json', 'design', 'validate'],
                            cwd=staging, env=env, capture_output=True, text=True)
    try:
        report = json.loads(result.stdout)
    except ValueError:
        report = {}
    if result.returncode or not report.get('ok'):
        failed = {card: value['errors'] for card, value in report.get('cards', {}).items() if value.get('errors')}
        raise ReleaseError(f'Packaged cards fail design validate: {failed or result.stderr.strip()[-2000:]}')
    added = sorted({p.relative_to(staging).as_posix() for p in staging.rglob('*')} - set(before))
    if added in (['.studio/.runtime', '.studio/.runtime/operations.lock'],
                 ['.studio/.runtime', '.studio/.runtime/catalog.lock', '.studio/.runtime/operations.lock']):
        # CLI command/catalog locks are expected; the package never carries runtime state.
        for name in added[1:]:
            (staging / name).unlink()
        (staging / added[0]).rmdir()
        added = []
    if added:
        raise ReleaseError('Card validation wrote into the package staging tree: ' + ', '.join(added[:5]))


def card_members(lock: dict) -> set[str]:
    listing = subprocess.run(['git', '-C', str(lock['repo']), 'ls-tree', '-r', '--name-only', '-z', lock['commit'], '--', *lock['ids']],
                             capture_output=True, check=True).stdout.decode('utf-8').split('\0')
    return {'.studio/designs/' + name for name in listing
            if name and not (len(name.split('/')) > 2 and name.split('/')[1] in CARD_EXCLUDED_DIRS)}


def stage_cards(staging: Path, lock: dict) -> dict[str, str]:
    """Copy the locked cards from Git objects, independent of the card working tree."""
    archive = subprocess.run(['git', '-C', str(lock['repo']), 'archive', '--format=tar', lock['commit'], '--', *lock['ids']],
                             capture_output=True, check=True).stdout
    files = {}
    with tarfile.open(fileobj=io.BytesIO(archive)) as bundle:
        for member in bundle.getmembers():
            if member.isdir() or member.name == 'pax_global_header':
                continue
            if not member.isfile():
                raise ReleaseError('Locked card contains a link or special file: ' + member.name)
            relative = safe_member(member.name)
            if len(relative.parts) > 2 and relative.parts[1] in CARD_EXCLUDED_DIRS:
                continue
            name = '.studio/designs/' + relative.as_posix()
            target = staging / name
            if target.exists():
                raise ReleaseError('Personal card overlaps a packaged file: ' + name)
            data = bundle.extractfile(member).read()
            if data.startswith(b'version https://git-lfs.github.com/spec/v1'):
                raise ReleaseError('Locked card file is a Git LFS pointer, not content: ' + member.name)
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            files[name] = sha256(target)
    return files


def stage_personal(staging: Path, source: Path | None) -> dict:
    if source is None:
        return {}
    declaration = personal_manifest(source)
    manifest_path = source / 'release-sources.json'
    result = {}
    for name, expected in declaration['files'].items():
        relative = safe_member(name)
        if personal_card_source(name):
            continue
        if (not (private_overlay(name) or name in PRIVATE_RULE_FILES)
                or any(part in {'.env', 'credentials', 'secrets', '__pycache__'} for part in relative.parts)
                or relative.suffix.lower() in {'.key', '.pem', '.p12', '.pyc'}):
            raise ReleaseError('Private package claims unsupported content: ' + name)
        path = source / relative
        if (not path.is_file() or path.stat().st_nlink != 1
                or any(p.is_symlink() for p in (path, *path.parents)) or sha256(path) != expected):
            raise ReleaseError('Private source missing, linked or changed: ' + name)
        if name in PRIVATE_RULE_FILES:
            result[name] = expected  # installed by stage_personal_rules after the public templates
            continue
        target = staging / relative
        if target.exists():
            raise ReleaseError('Private source overlaps public file: ' + name)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(path, target)
        if sha256(target) != expected or sha256(path) != expected:
            raise ReleaseError('Private source changed while freezing: ' + name)
        result[name] = expected
    personal = {'version': declaration['version'], 'compatibility': declaration['compatibility'],
                'manifest_sha256': sha256(manifest_path), 'files': result,
                'exclude_skills': declaration.get('exclude_skills', [])}
    if 'cards' in declaration:
        lock = card_lock(source, declaration['cards'])
        personal['cards'] = {'commit': lock['commit'], 'ids': lock['ids']}
    return personal


def stage_personal_rules(staging: Path, source: Path | None, personal: dict) -> None:
    for name in sorted(PRIVATE_RULE_FILES & set(personal.get('files', {}))):
        shutil.copyfile(source / name, staging / name)
        if sha256(staging / name) != personal['files'][name]:
            raise ReleaseError('Private source changed while freezing: ' + name)


def personal_card_ids(staging: Path) -> set[str]:
    manifest = staging / '.release.json'
    if not manifest.is_file():
        return set()
    personal = json.loads(manifest.read_text(encoding='utf-8')).get('personal_source') or {}
    return set(personal.get('cards', {}).get('ids', []))


def validate_distribution(staging: Path, personal_cards=()) -> None:
    # Public packages ship only the built-in stage cards; a personal package adds exactly the cards its
    # private source pins from the card repository, and no other personal card resource (D4/P6).
    scopes = package_scopes()
    expected = set(scopes['public_cards']) | set(personal_cards)
    shipped = tuple(f'.studio/designs/{card}/' for card in personal_cards)
    actual = {p.parent.name for p in (staging / '.studio/designs').glob('*/design.json')}
    if actual != expected:
        raise ReleaseError(f'Incomplete package design catalog: expected {sorted(expected)}, got {sorted(actual)}')
    prefixes = tuple(scopes['personal_prefixes'])
    personal_files = set(scopes['personal_files'])
    for path in staging.rglob('*'):
        if not path.is_file():
            continue
        relative = path.relative_to(staging).as_posix()
        if relative.startswith(shipped):
            continue
        if relative.startswith(prefixes) or relative in personal_files:
            raise ReleaseError('Personal card resource in product package: ' + relative)


def candidate(build_id: str, output_dir: Path, runtime_cache: Path, includes: list[str], *, channel: str = "candidate", runtime_files: dict | None = None, personal_source: Path | None = None) -> Path:
    if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,79}", build_id):
        raise ReleaseError("Candidate ID must use lowercase letters, digits, dots or hyphens")
    if channel not in {"candidate", "local"}:
        raise ReleaseError("Unsupported local build channel")
    identity = f"{channel}-{build_id}"
    output_dir.mkdir(parents=True, exist_ok=True)
    archive = output_dir / f"magic-video-{identity}-windows-x64.zip"
    checksum = archive.with_suffix(archive.suffix + ".sha256")
    fingerprint = candidate_fingerprint(includes, channel, runtime_files, personal_source)
    if archive.exists() or checksum.exists():
        cached_identity = verified_archive(archive)
        with zipfile.ZipFile(archive) as bundle:
            cached = json.loads(bundle.read(cached_identity + '/.release.json'))
        if cached_identity != identity or cached.get('input_fingerprint') != fingerprint:
            raise ReleaseError(f'Candidate ID already belongs to different inputs: {archive}')
        print(archive)
        return archive
    head = run("git", "rev-parse", "HEAD", capture=True)
    dirty = bool(run("git", "status", "--porcelain", capture=True))
    timestamp = int(datetime.now(timezone.utc).timestamp())
    with tempfile.TemporaryDirectory(prefix="hf-candidate-") as temporary:
        staging = Path(temporary) / identity
        staging.mkdir()
        sources = freeze_sources(staging, includes)
        personal = stage_personal(staging, personal_source)
        validate_distribution(staging)
        skills = stage_skills(staging, personal.get('exclude_skills', []))
        runtime = stage_runtime(staging, runtime_cache) if runtime_files is None else {}
        verified_runtime = {p.relative_to(staging).as_posix(): sha256(p)
                            for p in (staging / "runtime").rglob("*") if p.is_file()} if runtime_files is None else {}
        stage_windows_rules(staging)
        stage_personal_rules(staging, personal_source, personal)
        release_checks(staging)
        strip_bundled_assets(staging)
        release_checks(staging, packaged=True)
        strip_development_outputs(staging)
        if 'cards' in personal:
            # Cards join after the tool checks: their content evolves in the card repository, not with the tests.
            stage_cards(staging, card_lock(personal_source, personal_manifest(personal_source)['cards']))
            validate_distribution(staging, personal['cards']['ids'])
            validate_cards(staging)
        sources = {name: digest for name, digest in sources.items() if (staging / name).is_file()}
        manifest = {"schema_version": 3, "layout": "root-v1", "channel": channel, "release": identity,
                    "input_fingerprint": fingerprint,
                    "product_version": PRODUCT_VERSION, "flavor": "personal" if personal_source else "public",
                    "personal_source": personal,
                    "package_kind": "full" if runtime_files is None else "tools",
                    "commit": head, "dirty": dirty, "target": "windows-x64",
                    "built_at": datetime.fromtimestamp(timestamp, timezone.utc).isoformat(),
                    "source_file_sha256": sources, "runtime_asset_sha256": runtime,
                    "modules": module_manifest(staging),
                    "local_skill_sha256": skills,
                    "files": {p.relative_to(staging).as_posix(): sha256(p)
                              for p in sorted(staging.rglob("*")) if p.is_file()}}
        if runtime_files is not None:
            manifest.update(runtime_files=runtime_files, runtime_lock_sha256=sha256(staging / "windows-runtime.lock.json"))
        (staging / ".release.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        if candidate_fingerprint(includes, channel, runtime_files, personal_source) != fingerprint:
            raise ReleaseError('Candidate inputs changed during build; retry from stable inputs')
        write_zip(staging, archive, identity, timestamp, verified_runtime=verified_runtime)
    checksum.write_text(f"{sha256(archive)}  {archive.name}\n", encoding="ascii")
    print(archive)
    return archive


def build(version_value: str, output_dir: Path, runtime_cache: Path) -> Path:
    version, tag = version_tag(version_value)
    if run("git", "status", "--porcelain", capture=True):
        raise ReleaseError("Refusing to build from a dirty working tree")
    head = run("git", "rev-parse", "HEAD", capture=True)
    tagged = run("git", "rev-parse", f"{tag}^{{commit}}", capture=True)
    if tagged != head:
        raise ReleaseError(f"{tag} does not point at HEAD")
    try:
        upstream = run("git", "rev-parse", "@{upstream}", capture=True)
    except subprocess.CalledProcessError as exc:
        raise ReleaseError("The current branch needs an upstream before release") from exc
    if upstream != head:
        raise ReleaseError("Refusing to build from a branch that is not synchronized with upstream")

    output_dir.mkdir(parents=True, exist_ok=True)
    archive = output_dir / f"magic-video-harness-{version}-windows-x64.zip"
    checksum = archive.with_suffix(archive.suffix + ".sha256")
    if archive.exists() or checksum.exists():
        raise ReleaseError(f"Release artifact already exists: {archive}")

    with tempfile.TemporaryDirectory() as temporary:
        staging = Path(temporary) / tag
        staging.mkdir()
        sources = freeze_sources(staging, [])

        assert_no_development_harness(staging)

        dependency_hashes = stage_skills(staging)

        runtime_hashes = stage_runtime(staging, runtime_cache)
        verified_runtime = {p.relative_to(staging).as_posix(): sha256(p)
                            for p in (staging / "runtime").rglob("*") if p.is_file()}
        timestamp = int(run("git", "show", "-s", "--format=%ct", f"{tag}^{{commit}}", capture=True))
        stage_windows_rules(staging)
        release_checks(staging)
        strip_bundled_assets(staging)
        release_checks(staging, packaged=True)
        strip_development_outputs(staging)
        files = {
            path.relative_to(staging).as_posix(): sha256(path)
            for path in sorted(p for p in staging.rglob("*") if p.is_file())
        }
        manifest = {
            "schema_version": 3,
            "layout": "root-v1",
            "channel": "stable",
            "product_version": PRODUCT_VERSION, "flavor": "public",
            "source_file_sha256": sources, "modules": module_manifest(staging),
            "release": tag,
            "commit": head,
            "target": "windows-x64",
            "built_at": datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="seconds"),
            "runtime_asset_sha256": runtime_hashes,
            "local_skill_sha256": dependency_hashes,
            "files": files,
        }
        (staging / ".release.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        write_zip(staging, archive, tag, timestamp, verified_runtime=verified_runtime)

    checksum.write_text(f"{sha256(archive)}  {archive.name}\n", encoding="ascii")
    print(archive)
    return archive


def reusable_runtime(root: Path, lock_path: Path) -> dict | None:
    state_path = root / ".studio/.runtime/deployment.json"
    if not state_path.exists():
        return None
    state = json.loads(state_path.read_text(encoding="utf-8"))
    if state["files"].get("windows-runtime.lock.json") != sha256(lock_path):
        return None
    files = {name: value for name, value in state["files"].items() if name.startswith("runtime/")}
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    if not files or lock.get("pending_assets") or not lock.get("required_files") or not all(name in files for name in lock["required_files"]):
        return None
    return files


def prune_artifacts(parent: Path, target: str, keep: int, current: Path | None = None) -> list[str]:
    """Only new-entrypoint receipts grant ownership, never filename or age alone."""
    sys.path.insert(0, str(REPO / ".studio"))
    from root_deploy import safe
    completed = []
    for directory in sorted(parent.iterdir(), reverse=True):
        try:
            safe(parent, directory.name)
            receipt = json.loads(safe(directory, "receipt.json").read_text(encoding="utf-8"))
            if not isinstance(receipt, dict) or not isinstance(receipt.get("artifacts"), dict):
                continue
            if receipt.get("owner") != "release-deploy-v1" or receipt.get("target") != target:
                continue
            expected = receipt["artifacts"]
            if set(p.name for p in directory.iterdir()) != set(expected) | {"receipt.json"}:
                continue
            if any(sha256(safe(directory, name)) != value for name, value in expected.items()):
                continue
            completed.append(directory)
        except (ValueError, OSError, KeyError, TypeError):
            continue
    if current is not None:
        if current not in completed:
            return []
        completed.remove(current)
        completed.insert(0, current)
    removed = []
    for directory in completed[keep:]:
        shutil.rmtree(directory)
        removed.append(str(directory))
    return removed


def install_archive(archive: Path, root: Path, expected_hash: str, keep: int, config: Path | None) -> dict:
    if sha256(archive) != expected_hash:
        raise ReleaseError("Transferred archive checksum differs; target not touched")
    identity = verified_archive(archive)
    unpacked = archive.parent / "unpacked"
    unpacked.mkdir()
    extract_zip(archive, unpacked)
    package = unpacked / identity
    sys.path.insert(0, str(package / ".studio"))
    import root_deploy
    result = root_deploy.deploy(package, root, config, keep)
    result["managed_count"] = len(result.pop("files"))
    result["package_kind"] = root_deploy.read(package / ".release.json").get("package_kind", "full")
    return result


def deploy_windows(args) -> dict:
    if sys.platform != "linux" or not re.fullmatch(r"[A-Za-z]:[\\/].+", args.root) or any(c in args.root for c in "\r\n\0"):
        raise ReleaseError("Run deploy in WSL with an absolute Windows drive path")
    if args.keep < 1:
        raise ReleaseError("Keep at least one rollback version")
    personal_source = args.personal_source.resolve() if args.personal_source else None
    root = Path(run("wslpath", "-u", args.root, capture=True))
    sys.path.insert(0, str(REPO / ".studio"))
    from root_deploy import safe
    safe(root.parent, root.name)
    target = run("wslpath", "-w", str(root), capture=True)
    target_key = hashlib.sha256(target.casefold().encode()).hexdigest()[:16]
    parent = args.output_dir.resolve() / "deployments" / target_key
    parent.mkdir(parents=True, exist_ok=True)
    # One host build/transfer per target; the native command also holds its root lock.
    import fcntl
    with (parent / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        started = time.monotonic()
        timing = {}
        # Only the small locked Python bootstrap precedes the native root preflight.
        runtime_lock = json.loads(RUNTIME_LOCK.read_text(encoding="utf-8"))
        python_asset = next((asset for asset in runtime_lock["assets"] if asset["kind"] == "python"), None)
        if python_asset is None:
            raise ReleaseError("Runtime lock is missing bootstrap Python")
        python_zip = args.runtime_cache / safe_member(python_asset["file"])
        if sha256(python_zip) != python_asset["sha256"]:
            raise ReleaseError("Bootstrap Python differs from runtime lock")
        staging_parent = safe(root.parent, ".hyperframes-deploy")
        staging_parent.mkdir(parents=True, exist_ok=True)
        stage = staging_parent / ("deploy-" + uuid.uuid4().hex)
        stage.mkdir()
        extract_zip(python_zip, stage / "python")
        (stage / "python/python.exe").chmod(0o700)
        for name in ("root_deploy.py", "windows_runtime.py"):
            shutil.copyfile(REPO / ".studio" / name, stage / name)
        proposed = set(source_hashes(args.include)) | {"AGENTS.md", "CLAUDE.md", ".studio/AGENTS.md", ".release.json"}
        proposed = {name for name in proposed if not name.startswith((".studio/components/", ".studio/backgrounds/"))}
        declaration = personal_manifest(personal_source) if personal_source is not None else {}
        excluded = declaration.get('exclude_skills', [])
        for skill in LOCAL_SKILLS.keys() - set(excluded):
            proposed.update(path.relative_to(REPO).as_posix() for path in (REPO / ".agents/skills" / skill).rglob("*")
                            if path.is_file() and "__pycache__" not in path.parts)
        if personal_source is not None:
            proposed.update(name for name in declaration["files"] if not personal_card_source(name))
            if "cards" in declaration:
                proposed.update(card_members(card_lock(personal_source, declaration["cards"])))
        expected = {name: declaration.get('files', {}).get(name, sha256(REPO / template)) for name, template in (
            *PRIVATE_RULE_BASES.items(), ('.studio/AGENTS.md', '.studio/templates/STUDIO_AGENTS.md'))}
        for name, value in declaration.get('files', {}).items():
            expected.setdefault(name, value)  # identical private files already present are adopted, not refused
        expected['skills-lock.json'] = hashlib.sha256(skill_lock_bytes(REPO / 'skills-lock.json', excluded)).hexdigest()
        (stage / 'expected.json').write_text(json.dumps(expected), encoding='utf-8')
        installed = safe(root, ".studio/.runtime/deployment.json")
        if installed.is_file():
            proposed.update(name for name in json.loads(installed.read_text(encoding="utf-8"))["files"] if name.startswith("runtime/"))
        (stage / "retained.json").write_text(json.dumps(sorted(proposed)), encoding="utf-8")
        win = lambda path: run("wslpath", "-w", str(path), capture=True)
        preflight_command = [str(stage / "python/python.exe"), "-B", win(stage / "root_deploy.py"),
                             "preflight", "--root", target, "--retained", win(stage / "retained.json"),
                             "--expected", win(stage / 'expected.json'), "--recover-once"]
        if args.config:
            preflight_command.extend(["--config", args.config])
        preliminary = subprocess.run(preflight_command, cwd=stage, capture_output=True, text=True)
        (stage / "preflight.stdout.log").write_text(preliminary.stdout, encoding="utf-8")
        (stage / "preflight.stderr.log").write_text(preliminary.stderr, encoding="utf-8")
        if preliminary.returncode:
            raise ReleaseError(f"Native preflight failed ({preliminary.returncode}); no candidate built; evidence: {stage}\n{preliminary.stderr}")
        timing["preflight_seconds"] = time.monotonic() - started
        runtime_files = None if args.full else reusable_runtime(root, RUNTIME_LOCK)
        fingerprint = candidate_fingerprint(args.include, "local", runtime_files, personal_source)
        build_id = fingerprint[:32]
        output = parent / build_id
        output.mkdir(exist_ok=True)
        build_started = time.monotonic()
        cached = any(output.glob("*.zip"))
        archive = candidate(build_id, output, args.runtime_cache.resolve(), args.include,
                            channel="local", runtime_files=runtime_files, personal_source=personal_source)
        timing["build_seconds"] = time.monotonic() - build_started
        identity = verified_archive(archive)
        with zipfile.ZipFile(archive) as bundle:
            bootstrap = bundle.read(identity + "/release")
        (stage / "release.py").write_bytes(bootstrap)
        transfer_started = time.monotonic()
        for path in (archive, archive.with_suffix(archive.suffix + ".sha256")):
            shutil.copy2(path, stage / path.name)
        timing["transfer_seconds"] = time.monotonic() - transfer_started
        install_started = time.monotonic()
        command = [str(stage / "python/python.exe"), "-B", win(stage / "release.py"),
                   "_install", "--archive", win(stage / archive.name), "--root", target,
                   "--sha256", sha256(archive), "--keep", str(args.keep)]
        if args.config:
            command.extend(["--config", args.config])
        result = subprocess.run(command, cwd=stage, capture_output=True, text=True)
        (output / "stdout.log").write_text(result.stdout, encoding="utf-8")
        (output / "stderr.log").write_text(result.stderr, encoding="utf-8")
        if result.returncode:
            raise ReleaseError(f"Native deployment failed ({result.returncode}); staging retained: {stage}; logs: {output}\n{result.stderr}")
        receipt = json.loads(result.stdout)
        receipt.update(owner="release-deploy-v1", target=target, archive_bytes=archive.stat().st_size,
                       preflight=json.loads(preliminary.stdout), candidate_reused=cached,
                       timings={**timing, "install_seconds": time.monotonic() - install_started,
                                "total_seconds": time.monotonic() - started})
        receipt["artifacts"] = {path.name: sha256(path) for path in output.iterdir() if path.is_file() and path.name != "receipt.json"}
        (output / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
        try:
            # The native process has exited; only this invocation's fresh staging is removed.
            for path in stage.rglob("*"):
                safe(stage, path.relative_to(stage).as_posix())
            shutil.rmtree(stage)
            receipt["removed_artifacts"] = prune_artifacts(parent, target, args.keep + 1, output)
        except (ValueError, OSError) as error:
            receipt["cleanup_deferred"] = str(error)
        (output / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
        return receipt


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(description=__doc__)
    subcommands = command.add_subparsers(dest="command", required=True)
    build_parser = subcommands.add_parser("build")
    build_parser.add_argument("version")
    build_parser.add_argument("--output-dir", type=Path, default=REPO / "dist")
    build_parser.add_argument("--runtime-cache", type=Path, required=True)
    candidate_parser = subcommands.add_parser("candidate", aliases=["local"])
    candidate_parser.add_argument("build_id")
    candidate_parser.add_argument("--output-dir", type=Path, default=REPO / "dist")
    candidate_parser.add_argument("--runtime-cache", type=Path, required=True)
    candidate_parser.add_argument("--include", action="append", default=[], help="Explicit new public file; repeat for each untracked addition")
    candidate_parser.add_argument('--personal-source', type=Path, help='Assemble exact private release-sources.json; omitted builds public content')
    check_parser = subcommands.add_parser("check-personal", help="Check a private source (files, bases, card lock) without building")
    check_parser.add_argument("--personal-source", type=Path, required=True)
    verify_parser = subcommands.add_parser("verify")
    verify_parser.add_argument("archive", type=Path)
    deploy_parser = subcommands.add_parser("deploy", help="Build and deploy from WSL to a Windows root")
    deploy_parser.add_argument("--root", required=True)
    deploy_parser.add_argument("--runtime-cache", type=Path, default=REPO / ".studio/.runtime/windows-runtime-cache")
    deploy_parser.add_argument("--output-dir", type=Path, default=REPO / "dist")
    deploy_parser.add_argument("--include", action="append", default=[])
    deploy_parser.add_argument("--config", help="Windows JSON path for first installation only")
    deploy_parser.add_argument("--keep", type=int, default=1, help="Rollback versions (minimum 1); archives keep this many plus current")
    deploy_parser.add_argument("--full", action="store_true", help="Include runtime even if its lock matches")
    deploy_parser.add_argument("--personal-source", type=Path, help="Assemble exact private release-sources.json; omitted deploys public content")
    install_parser = subcommands.add_parser("_install", help=argparse.SUPPRESS)
    install_parser.add_argument("--archive", required=True, type=Path)
    install_parser.add_argument("--root", required=True, type=Path)
    install_parser.add_argument("--sha256", required=True)
    install_parser.add_argument("--keep", type=int, default=1)
    install_parser.add_argument("--config", type=Path)
    return command


def main(arguments: list[str] | None = None) -> int:
    args = parser().parse_args(arguments)
    try:
        if args.command == "build":
            build(args.version, args.output_dir.resolve(), args.runtime_cache.resolve())
        elif args.command in {"candidate", "local"}:
            candidate(args.build_id, args.output_dir.resolve(), args.runtime_cache.resolve(), args.include, channel=args.command,
                      personal_source=args.personal_source.resolve() if args.personal_source else None)
        elif args.command == "check-personal":
            with tempfile.TemporaryDirectory(prefix="personal-check-") as temporary:
                print(json.dumps(stage_personal(Path(temporary), args.personal_source.resolve()), indent=2))
        elif args.command == "deploy":
            print(json.dumps(deploy_windows(args), indent=2))
        elif args.command == "_install":
            if sys.platform != "win32":
                raise ReleaseError("Internal installer requires native Windows Python")
            print(json.dumps(install_archive(args.archive, args.root, args.sha256, args.keep, args.config), indent=2))
        else:
            print(verified_archive(args.archive.resolve()))
    except (ReleaseError, subprocess.CalledProcessError, OSError, KeyError, ValueError, zipfile.BadZipFile) as exc:
        print(f"release: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
