#!/usr/bin/env python3
"""Export the public stage cards as a standalone share package.

Development only: never a product source. The package holds the stage-full / stage-light cards
without runnable examples or fonts, the two runtime files their assets need, reference copies of
the specs their stages cite, and the README / AGENTS templates from share/stage-cards/.
Example references in the card documents are rewritten by share/stage-cards/rewrites.json; a rule
that no longer matches its source exactly once stops the export so the rules get updated.
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile


REPO = Path(__file__).resolve().parent
SHARE = REPO / "share" / "stage-cards"
CARDS = ("stage-full", "stage-light")
# Published path -> repository source, besides the card trees.
EXTRA = {
    "LICENSE": "LICENSE",
    "runtime/motion.js": ".studio/runtime/motion.js",
    "runtime/scene-binding.js": ".studio/runtime/scene-binding.js",
    "spec/visual-design.md": ".studio/spec/visual-design.md",
    "spec/hyperframes.md": ".studio/spec/hyperframes.md",
}
# Runnable examples need the fonts and host runtime this package leaves out.
EXCLUDED_CARD_PARTS = {"example", "example-manifest.json"}
# Anything here in the output means a rewrite rule or a source document leaked local or private detail.
LEAKS = {
    "local path": re.compile(r"/home/|/mnt/|[A-Z]:\\"),
    "Work number": re.compile(r"\bWork ?\d{2,3}\b"),
    "model name": re.compile(r"DeepSeek|\bgpt-?\d|\bOpus\b|\bClaude\b|\bCodex\b|\bGemini\b", re.IGNORECASE),
    "image service": re.compile(r"generate_image|\bMCP\b"),
}
# Change logs may keep historical example paths; current documents may not point at missing files.
EXAMPLE_REFERENCE = re.compile(r"example/|example-manifest|__example|\.\./shared/|design_examples")
PREVIOUS_EXPORT = ("README.md", "AGENTS.md", "designs/stage-full/design.json")


class ExportError(Exception):
    pass


def tracked(prefix: str) -> list[str]:
    result = subprocess.run(["git", "-C", str(REPO), "ls-files", "-z", "--", prefix],
                            capture_output=True, check=True)
    return sorted(name for name in result.stdout.decode("utf-8").split("\0") if name)


def card_files(card: str) -> dict[str, str]:
    prefix = f".studio/designs/{card}/"
    files = {}
    for name in tracked(prefix):
        relative = name[len(prefix):]
        if relative.split("/")[0] in EXCLUDED_CARD_PARTS:
            continue
        files[f"designs/{card}/{relative}"] = name
    if f"designs/{card}/design.json" not in files:
        raise ExportError(f"{card}: design.json is not tracked")
    return files


def sources() -> dict[str, str]:
    files = {}
    for card in CARDS:
        files.update(card_files(card))
    for published, source in EXTRA.items():
        if not tracked(source):
            raise ExportError(f"Source is not tracked: {source}")
        files[published] = source
    return files


def rewrite(staging: Path) -> int:
    rules = json.loads((SHARE / "rewrites.json").read_text(encoding="utf-8"))
    if rules.get("schema_version") != 1 or not isinstance(rules.get("rewrites"), list):
        raise ExportError("Invalid share/stage-cards/rewrites.json")
    for rule in rules["rewrites"]:
        path = staging / rule["file"]
        text = path.read_text(encoding="utf-8") if path.is_file() else ""
        count = text.count(rule["old"])
        if count != 1:
            raise ExportError(f"{rule['file']}: rewrite matches {count} times; update share/stage-cards/rewrites.json "
                              f"for: {rule['old'][:60]!r}")
        path.write_text(text.replace(rule["old"], rule["new"]), encoding="utf-8")
    return len(rules["rewrites"])


def write_docs(staging: Path) -> None:
    versions = {card: json.loads((staging / f"designs/{card}/design.json").read_text(encoding="utf-8"))["version"]
                for card in CARDS}
    readme = (SHARE / "README.md").read_text(encoding="utf-8")
    for card, version in versions.items():
        readme = readme.replace(f"@@{card}@@", str(version))
    if "@@" in readme:
        raise ExportError("README template has an unknown placeholder")
    (staging / "README.md").write_text(readme, encoding="utf-8")
    shutil.copyfile(SHARE / "AGENTS.md", staging / "AGENTS.md")


def scan(staging: Path) -> list[str]:
    findings = []
    for path in sorted(staging.rglob("*")):
        if not path.is_file() or path.suffix not in {".md", ".json", ".js", ".mjs"}:
            continue
        name = path.relative_to(staging).as_posix()
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            for label, pattern in LEAKS.items():
                if pattern.search(line):
                    findings.append(f"{name}:{number}: {label}")
            if path.name != "CHANGELOG.md" and EXAMPLE_REFERENCE.search(line):
                findings.append(f"{name}:{number}: example reference")
    return findings


def build(staging: Path) -> dict:
    files = sources()
    for published, source in files.items():
        target = staging / published
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(REPO / source, target)
    rules = rewrite(staging)
    write_docs(staging)
    findings = scan(staging)
    if findings:
        raise ExportError("Export would leak or dangle:\n  " + "\n  ".join(findings))
    return {"files": len(files) + 2, "rewrites": rules}


def write_zip(directory: Path, target: Path) -> None:
    # Fixed timestamps and order so the same sources always give the same archive.
    temporary = target.with_name(target.name + ".tmp")
    with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(directory.rglob("*")):
            name = f"{directory.name}/{path.relative_to(directory).as_posix()}"
            if path.is_dir():
                continue
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = 0o644 << 16
            archive.writestr(info, path.read_bytes())
    temporary.replace(target)


def replaceable(output: Path) -> bool:
    return output.is_dir() and all((output / name).is_file() for name in PREVIOUS_EXPORT)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--output", type=Path, default=REPO / "dist" / "magic-video-stage-cards",
                        help="Package directory to create (default: dist/magic-video-stage-cards)")
    parser.add_argument("--zip", action="store_true", help="Also write <output>.zip")
    parser.add_argument("--force", action="store_true",
                        help="Replace an existing output that is a previous export, and its zip")
    args = parser.parse_args(argv)
    output = args.output.resolve()
    archive = output.with_name(output.name + ".zip")
    try:
        if output.exists() and not (args.force and replaceable(output)):
            raise ExportError(f"Output exists: {output}" + ("" if args.force else " (pass --force to replace a previous export)")
                              + (" and is not a previous export" if args.force else ""))
        if args.zip and archive.exists() and not args.force:
            raise ExportError(f"Zip exists: {archive} (pass --force to replace it)")
        output.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".stage-cards-", dir=output.parent) as temporary:
            staging = Path(temporary) / output.name
            report = build(staging)
            if output.exists():
                shutil.rmtree(output)
            staging.rename(output)
        if args.zip:
            write_zip(output, archive)
    except (ExportError, OSError, subprocess.CalledProcessError) as error:
        print(f"export-stage-cards: {error}", file=sys.stderr)
        return 1
    print(json.dumps({"output": str(output), "zip": str(archive) if args.zip else None, **report}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
